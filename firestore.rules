rules_version = '2';
// 셰프 마스터 Firestore 보안 규칙
// - 학생: 로그인 없이 반·번호·이름·4자리 코드
// - 선생님: 구글 계정 로그인 + config/admins 문서의 emails 명단에 있어야 함
//   (명단은 Firebase 콘솔에서만 고칠 수 있고, 게임에서는 아무도 바꿀 수 없음)
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails;
    }
    function chatOpen(ban) {
      return !exists(/databases/$(database)/documents/classes/$(ban))
        || get(/databases/$(database)/documents/classes/$(ban)).data.get('chatOff', false) != true;
    }

    match /shops/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name', 'ban', 'no', 'codeHash'])
        && id == string(request.resource.data.ban) + '-' + string(request.resource.data.no);
      // 학생: 같은 코드로만 / 선생님이 코드를 초기화(null)했으면 학생이 새 코드로 한 번 등록 / 선생님은 코드 초기화 가능
      allow update: if resource.data.codeHash == request.resource.data.codeHash
        || (resource.data.codeHash == null && request.resource.data.codeHash is string)
        || isTeacher();
      allow delete: if isTeacher();
    }
    match /guestbooks/{gid} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['to', 'from', 'sticker', 'at'])
        && request.resource.data.sticker in ['best', 'yum', 'clean', 'cheer', 'rich', 'again'];
      allow update: if false;
      allow delete: if isTeacher();
    }
    match /presence/{id} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['name', 'ban', 'no', 'mode', 'visiting', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 10;
    }
    match /visits/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'ban', 'chef', 'state', 'sticker', 'stickerAt', 'at'])
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 10;
      allow delete: if true;
    }
    match /chats/{ban}/msgs/{id} {
      allow read: if true;
      allow create: if request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 60
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && ((request.resource.data.teacher == false && chatOpen(ban))
            || (request.resource.data.teacher == true && isTeacher()));
      allow update: if false;
      allow delete: if isTeacher();
    }
    match /announcements/{id} {
      allow read: if true;
      allow create: if isTeacher() && request.resource.data.text is string && request.resource.data.text.size() <= 100;
      allow update: if false;
      allow delete: if isTeacher();
    }
    match /classes/{ban} {
      allow read: if true;
      allow write: if isTeacher();
    }
    // 서버 열기/닫기: 누구나 읽기, 선생님만 바꾸기
    match /config/server {
      allow read: if true;
      allow write: if isTeacher();
    }
    // 선생님 명단: 명단에 있는 선생님만 읽을 수 있고(로그인 확인용), 게임에서는 아무도 못 바꿈 → 콘솔에서만 수정
    match /config/admins {
      allow read: if isTeacher();
      allow write: if false;
    }
  }
}
